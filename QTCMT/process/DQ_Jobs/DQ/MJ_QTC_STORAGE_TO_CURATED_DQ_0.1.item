    <elementParameter field="DIRECTORY" name="JAVA_LIBRARY_PATH" value="C:\Users\Admin\Downloads\Talend-Studio-20250226_1030-V8.0.1\Talend-Studio-20250226_1030-V8.0.1\configuration\lib\java" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="String[] identifiers = {&#xD;&#xA;&#x9;    context.sf_database, context.sf_qtc_storage_schema, context.sf_curated_schema,&#xD;&#xA;&#x9;    context.sf_control_schema, context.sf_exception_schema&#xD;&#xA;&#x9;};&#xD;&#xA;&#x9;for (String identifier : identifiers) {&#xD;&#xA;&#x9;    if (identifier == null || !identifier.matches(&quot;[A-Za-z_][A-Za-z0-9_$]*&quot;)) {&#xD;&#xA;&#x9;        throw new IllegalArgumentException(&quot;Unsafe or empty Snowflake identifier: &quot; + identifier);&#xD;&#xA;&#x9;    }&#xD;&#xA;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;final String db = context.sf_database;&#xD;&#xA;&#x9;final String raw = db + &quot;.&quot; + context.sf_qtc_storage_schema;&#xD;&#xA;&#x9;final String curated = db + &quot;.&quot; + context.sf_curated_schema;&#xD;&#xA;&#x9;final String control = db + &quot;.&quot; + context.sf_control_schema;&#xD;&#xA;&#x9;final String exception = db + &quot;.&quot; + context.sf_exception_schema;&#xD;&#xA;&#x9;final String runId = context.run_id.replace(&quot;'&quot;, &quot;''&quot;);&#xD;&#xA;&#xD;&#xA;&#x9;// --- Connection resolution ---&#xD;&#xA;&#x9;// Try the wired tSnowflakeConnection first; if it's missing (wiring/naming issue,&#xD;&#xA;&#x9;// or the component simply hasn't executed in this branch), open one directly&#xD;&#xA;&#x9;// instead of hard-failing the job.&#xD;&#xA;&#x9;java.sql.Connection sf = (java.sql.Connection) globalMap.get(&quot;conn_tSnowflakeConnection_1&quot;);&#xD;&#xA;&#x9;boolean ownsConnection = false;&#xD;&#xA;&#xD;&#xA;&#x9;if (sf == null) {&#xD;&#xA;&#x9;    try {&#xD;&#xA;&#x9;        System.out.println(&quot;WARN: conn_tSnowflakeConnection_1 not found in globalMap. &quot;&#xD;&#xA;&#x9;            + &quot;Opening a direct fallback Snowflake connection.&quot;);&#xD;&#xA;&#xD;&#xA;&#x9;        if (context.sf_account == null || context.sf_account.isEmpty()) {&#xD;&#xA;&#x9;            throw new IllegalStateException(&quot;context.sf_account is required for the fallback connection but is empty.&quot;);&#xD;&#xA;&#x9;        }&#xD;&#xA;&#x9;        if (context.sf_user == null || context.sf_user.isEmpty()) {&#xD;&#xA;&#x9;            throw new IllegalStateException(&quot;context.sf_user is required for the fallback connection but is empty.&quot;);&#xD;&#xA;&#x9;        }&#xD;&#xA;&#x9;        if (context.sf_password == null || context.sf_password.isEmpty()) {&#xD;&#xA;&#x9;            throw new IllegalStateException(&quot;context.sf_password is required for the fallback connection but is empty.&quot;);&#xD;&#xA;&#x9;        }&#xD;&#xA;&#x9;        if (context.sf_warehouse == null || context.sf_warehouse.isEmpty()) {&#xD;&#xA;&#x9;            throw new IllegalStateException(&quot;context.sf_warehouse is required for the fallback connection but is empty.&quot;);&#xD;&#xA;&#x9;        }&#xD;&#xA;&#xD;&#xA;&#x9;        StringBuilder url = new StringBuilder(&quot;jdbc:snowflake://&quot;)&#xD;&#xA;&#x9;            .append(context.sf_account)&#xD;&#xA;&#x9;            .append(&quot;.snowflakecomputing.com/?db=&quot;).append(db)&#xD;&#xA;&#x9;            .append(&quot;&amp;warehouse=&quot;).append(context.sf_warehouse);&#xD;&#xA;&#x9;        if (context.sf_role != null &amp;&amp; !context.sf_role.isEmpty()) {&#xD;&#xA;&#x9;            url.append(&quot;&amp;role=&quot;).append(context.sf_role);&#xD;&#xA;&#x9;        }&#xD;&#xA;&#xD;&#xA;&#x9;        java.util.Properties props = new java.util.Properties();&#xD;&#xA;&#x9;        props.put(&quot;user&quot;, context.sf_user);&#xD;&#xA;&#x9;        props.put(&quot;password&quot;, context.sf_password);&#xD;&#xA;&#xD;&#xA;&#x9;        Class.forName(&quot;net.snowflake.client.jdbc.SnowflakeDriver&quot;);&#xD;&#xA;&#x9;        sf = java.sql.DriverManager.getConnection(url.toString(), props);&#xD;&#xA;&#x9;        globalMap.put(&quot;conn_tSnowflakeConnection_1&quot;, sf);&#xD;&#xA;&#x9;        ownsConnection = true;&#xD;&#xA;&#xD;&#xA;&#x9;        System.out.println(&quot;Fallback Snowflake connection established.&quot;);&#xD;&#xA;&#x9;    } catch (Exception connEx) {&#xD;&#xA;&#x9;        throw new IllegalStateException(&quot;Snowflake connection is unavailable, and fallback connection failed: &quot;&#xD;&#xA;&#x9;            + connEx.getMessage(), connEx);&#xD;&#xA;&#x9;    }&#xD;&#xA;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;sf.setAutoCommit(false);&#xD;&#xA;&#x9;try (java.sql.Statement st = sf.createStatement()) {&#xD;&#xA;&#x9;    java.util.List&lt;String> setup = java.util.Arrays.asList(&#xD;&#xA;&#x9;        &quot;CREATE SCHEMA IF NOT EXISTS &quot; + curated,&#xD;&#xA;&#x9;        &quot;CREATE SCHEMA IF NOT EXISTS &quot; + control,&#xD;&#xA;&#x9;        &quot;CREATE SCHEMA IF NOT EXISTS &quot; + exception,&#xD;&#xA;&#x9;        &quot;CREATE TABLE IF NOT EXISTS &quot; + control + &quot;.DQ_RUN (RUN_ID VARCHAR, JOB_NAME VARCHAR, ENVIRONMENT VARCHAR, START_TS TIMESTAMP_LTZ, END_TS TIMESTAMP_LTZ, STATUS VARCHAR, ROWS_READ NUMBER, ROWS_PASSED NUMBER, ROWS_REJECTED NUMBER, ERROR_MESSAGE VARCHAR)&quot;,&#xD;&#xA;&#x9;        &quot;CREATE TABLE IF NOT EXISTS &quot; + exception + &quot;.DQ_EXCEPTION (RUN_ID VARCHAR, ENTITY_NAME VARCHAR, RECORD_KEY VARCHAR, RULE_CODE VARCHAR, RULE_DESCRIPTION VARCHAR, SEVERITY VARCHAR, COLUMN_NAME VARCHAR, BAD_VALUE VARCHAR, DETECTED_AT TIMESTAMP_LTZ, RESOLUTION_STATUS VARCHAR)&quot;,&#xD;&#xA;&#x9;        &quot;CREATE TABLE IF NOT EXISTS &quot; + curated + &quot;.CUSTOMER (CUSTOMER_ID NUMBER(38,0), CUSTOMER_NAME VARCHAR, EMAIL VARCHAR, PHONE VARCHAR, STATUS VARCHAR, UPDATED_AT TIMESTAMP_NTZ, DQ_STATUS VARCHAR, DQ_RUN_ID VARCHAR, PROCESSED_AT TIMESTAMP_LTZ)&quot;,&#xD;&#xA;&#x9;        &quot;CREATE TABLE IF NOT EXISTS &quot; + curated + &quot;.ORDERS (ORDER_ID NUMBER(38,0), CUSTOMER_ID NUMBER(38,0), ORDER_DATE DATE, ORDER_AMOUNT NUMBER(18,2), ORDER_STATUS VARCHAR, UPDATED_AT TIMESTAMP_NTZ, DQ_STATUS VARCHAR, DQ_RUN_ID VARCHAR, PROCESSED_AT TIMESTAMP_LTZ)&quot;,&#xD;&#xA;&#x9;        &quot;CREATE TABLE IF NOT EXISTS &quot; + curated + &quot;.PAYMENTS (PAYMENT_ID NUMBER(38,0), ORDER_ID NUMBER(38,0), PAYMENT_DATE TIMESTAMP_NTZ, PAYMENT_AMOUNT NUMBER(18,2), PAYMENT_METHOD VARCHAR, PAYMENT_STATUS VARCHAR, UPDATED_AT TIMESTAMP_NTZ, DQ_STATUS VARCHAR, DQ_RUN_ID VARCHAR, PROCESSED_AT TIMESTAMP_LTZ)&quot;,&#xD;&#xA;&#x9;        &quot;CREATE OR REPLACE VIEW &quot; + control + &quot;.DQ_EXCEPTION AS SELECT E.*,CASE WHEN E.ENTITY_NAME='CUSTOMER' THEN 'Customer Data Steward' WHEN E.ENTITY_NAME='ORDERS' THEN 'Order Operations' WHEN E.ENTITY_NAME='PAYMENTS' THEN 'Payment Operations' ELSE 'Data Quality Team' END OWNER FROM &quot; + exception + &quot;.DQ_EXCEPTION E&quot;&#xD;&#xA;&#x9;    );&#xD;&#xA;&#x9;    for (String sql : setup) st.execute(sql);&#xD;&#xA;&#xD;&#xA;&#x9;    st.executeUpdate(&quot;DELETE FROM &quot; + exception + &quot;.DQ_EXCEPTION WHERE RUN_ID='&quot; + runId + &quot;'&quot;);&#xD;&#xA;&#x9;    st.executeUpdate(&quot;DELETE FROM &quot; + control + &quot;.DQ_RUN WHERE RUN_ID='&quot; + runId + &quot;'&quot;);&#xD;&#xA;&#x9;    st.executeUpdate(&quot;INSERT INTO &quot; + control + &quot;.DQ_RUN (RUN_ID,JOB_NAME,ENVIRONMENT,START_TS,STATUS) VALUES ('&quot; + runId + &quot;','MJ_QTC_STORAGE_TO_CURATED_DQ','&quot; + context.environment.replace(&quot;'&quot;, &quot;''&quot;) + &quot;',CURRENT_TIMESTAMP(),'RUNNING')&quot;);&#xD;&#xA;&#xD;&#xA;&#x9;    java.util.List&lt;String> customerRules = java.util.Arrays.asList(&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','CUSTOMER',COALESCE(TO_VARCHAR(CUSTOMER_ID),'&lt;NULL>'),'CUST_KEY_REQUIRED','CUSTOMER_ID is mandatory','CRITICAL','CUSTOMER_ID',TO_VARCHAR(CUSTOMER_ID),CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + raw + &quot;.CUSTOMER WHERE CUSTOMER_ID IS NULL&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','CUSTOMER',TO_VARCHAR(CUSTOMER_ID),'CUST_DUPLICATE_KEY','CUSTOMER_ID must be unique','CRITICAL','CUSTOMER_ID',TO_VARCHAR(CUSTOMER_ID),CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + raw + &quot;.CUSTOMER QUALIFY COUNT(*) OVER (PARTITION BY CUSTOMER_ID)>1&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','CUSTOMER',TO_VARCHAR(CUSTOMER_ID),'CUST_NAME_REQUIRED','Customer name cannot be blank','MAJOR','CUSTOMER_NAME',CUSTOMER_NAME,CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + raw + &quot;.CUSTOMER WHERE NULLIF(TRIM(CUSTOMER_NAME),'') IS NULL&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','CUSTOMER',TO_VARCHAR(CUSTOMER_ID),'CUST_INVALID_STATUS','Customer status is outside the approved domain','MAJOR','STATUS',STATUS,CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + raw + &quot;.CUSTOMER WHERE UPPER(COALESCE(STATUS,'')) NOT IN ('ACTIVE','INACTIVE','SUSPENDED')&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','CUSTOMER',TO_VARCHAR(CUSTOMER_ID),'CUST_INVALID_EMAIL','Email is missing or does not match the approved pattern','MAJOR','EMAIL',EMAIL,CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + raw + &quot;.CUSTOMER WHERE EMAIL IS NULL OR NOT REGEXP_LIKE(EMAIL,'^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+[.][A-Za-z]{2,}$')&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','CUSTOMER',TO_VARCHAR(CUSTOMER_ID),'CUST_INVALID_PHONE','Phone is missing or does not match the approved pattern','MAJOR','PHONE',PHONE,CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + raw + &quot;.CUSTOMER WHERE PHONE IS NULL OR NOT REGEXP_LIKE(PHONE,'^[0-9+() .-]{7,20}$')&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','CUSTOMER',TO_VARCHAR(CUSTOMER_ID),'CUST_DUPLICATE_CONTACT','Duplicate email and phone combination requires review','WARNING','EMAIL_PHONE',EMAIL||'|'||PHONE,CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + raw + &quot;.CUSTOMER WHERE EMAIL IS NOT NULL AND PHONE IS NOT NULL QUALIFY COUNT(*) OVER (PARTITION BY LOWER(TRIM(EMAIL)),REGEXP_REPLACE(PHONE,'[^0-9]',''))>1&quot;&#xD;&#xA;&#x9;    );&#xD;&#xA;&#x9;    for (String sql : customerRules) st.executeUpdate(sql);&#xD;&#xA;&#xD;&#xA;&#x9;    st.executeUpdate(&#xD;&#xA;&#x9;        &quot;MERGE INTO &quot; + curated + &quot;.CUSTOMER T USING (&quot; +&#xD;&#xA;&#x9;        &quot;SELECT CUSTOMER_ID,CUSTOMER_NAME,EMAIL,PHONE,UPPER(STATUS) STATUS,UPDATED_AT,&quot; +&#xD;&#xA;&#x9;        &quot;CASE WHEN COUNT(*) OVER (PARTITION BY LOWER(TRIM(EMAIL)),REGEXP_REPLACE(PHONE,'[^0-9]',''))>1 THEN 'WARNING' ELSE 'PASSED' END DQ_STATUS &quot; +&#xD;&#xA;&#x9;        &quot;FROM &quot; + raw + &quot;.CUSTOMER WHERE CUSTOMER_ID IS NOT NULL &quot; +&#xD;&#xA;&#x9;        &quot;AND UPPER(COALESCE(STATUS,'')) IN ('ACTIVE','INACTIVE','SUSPENDED') &quot; +&#xD;&#xA;&#x9;        &quot;AND NULLIF(TRIM(CUSTOMER_NAME),'') IS NOT NULL &quot; +&#xD;&#xA;&#x9;        &quot;AND EMAIL IS NOT NULL AND REGEXP_LIKE(EMAIL,'^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+[.][A-Za-z]{2,}$') &quot; +&#xD;&#xA;&#x9;        &quot;AND PHONE IS NOT NULL AND REGEXP_LIKE(PHONE,'^[0-9+() .-]{7,20}$') &quot; +&#xD;&#xA;&#x9;        &quot;QUALIFY ROW_NUMBER() OVER(PARTITION BY CUSTOMER_ID ORDER BY UPDATED_AT DESC NULLS LAST)=1) S &quot; +&#xD;&#xA;&#x9;        &quot;ON T.CUSTOMER_ID=S.CUSTOMER_ID WHEN MATCHED THEN UPDATE SET CUSTOMER_NAME=S.CUSTOMER_NAME,EMAIL=S.EMAIL,PHONE=S.PHONE,STATUS=S.STATUS,UPDATED_AT=S.UPDATED_AT,DQ_STATUS=S.DQ_STATUS,DQ_RUN_ID='&quot; + runId + &quot;',PROCESSED_AT=CURRENT_TIMESTAMP() &quot; +&#xD;&#xA;&#x9;        &quot;WHEN NOT MATCHED THEN INSERT (CUSTOMER_ID,CUSTOMER_NAME,EMAIL,PHONE,STATUS,UPDATED_AT,DQ_STATUS,DQ_RUN_ID,PROCESSED_AT) VALUES (S.CUSTOMER_ID,S.CUSTOMER_NAME,S.EMAIL,S.PHONE,S.STATUS,S.UPDATED_AT,S.DQ_STATUS,'&quot; + runId + &quot;',CURRENT_TIMESTAMP())&quot;&#xD;&#xA;&#x9;    );&#xD;&#xA;&#xD;&#xA;&#x9;    java.util.List&lt;String> orderRules = java.util.Arrays.asList(&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','ORDERS',COALESCE(TO_VARCHAR(O.ORDER_ID),'&lt;NULL>'),'ORDER_KEY_REQUIRED','ORDER_ID is mandatory','CRITICAL','ORDER_ID',TO_VARCHAR(O.ORDER_ID),CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + raw + &quot;.ORDERS O WHERE O.ORDER_ID IS NULL&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','ORDERS',TO_VARCHAR(ORDER_ID),'ORDER_DUPLICATE_KEY','ORDER_ID must be unique','CRITICAL','ORDER_ID',TO_VARCHAR(ORDER_ID),CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + raw + &quot;.ORDERS QUALIFY COUNT(*) OVER (PARTITION BY ORDER_ID)>1&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','ORDERS',TO_VARCHAR(O.ORDER_ID),'ORDER_ORPHAN_CUSTOMER','Order customer does not exist','CRITICAL','CUSTOMER_ID',TO_VARCHAR(O.CUSTOMER_ID),CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + raw + &quot;.ORDERS O LEFT JOIN &quot; + raw + &quot;.CUSTOMER C ON C.CUSTOMER_ID=O.CUSTOMER_ID WHERE C.CUSTOMER_ID IS NULL&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','ORDERS',TO_VARCHAR(ORDER_ID),'ORDER_AMOUNT_POSITIVE','ORDER_AMOUNT must be greater than zero','CRITICAL','ORDER_AMOUNT',TO_VARCHAR(ORDER_AMOUNT),CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + raw + &quot;.ORDERS WHERE ORDER_AMOUNT IS NULL OR ORDER_AMOUNT&lt;=0&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','ORDERS',TO_VARCHAR(ORDER_ID),'ORDER_INVALID_STATUS','Order status is outside the approved domain','MAJOR','ORDER_STATUS',ORDER_STATUS,CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + raw + &quot;.ORDERS WHERE UPPER(COALESCE(ORDER_STATUS,'')) NOT IN ('NEW','PAID','CANCELLED','REFUNDED')&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','ORDERS',TO_VARCHAR(ORDER_ID),'ORDER_INVALID_DATE','ORDER_DATE is mandatory and cannot be in the future','MAJOR','ORDER_DATE',TO_VARCHAR(ORDER_DATE),CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + raw + &quot;.ORDERS WHERE ORDER_DATE IS NULL OR ORDER_DATE>CURRENT_DATE()&quot;&#xD;&#xA;&#x9;    );&#xD;&#xA;&#x9;    for (String sql : orderRules) st.executeUpdate(sql);&#xD;&#xA;&#xD;&#xA;&#x9;    st.executeUpdate(&#xD;&#xA;&#x9;        &quot;MERGE INTO &quot; + curated + &quot;.ORDERS T USING (SELECT O.ORDER_ID,O.CUSTOMER_ID,O.ORDER_DATE,O.ORDER_AMOUNT,UPPER(O.ORDER_STATUS) ORDER_STATUS,O.UPDATED_AT,'PASSED' DQ_STATUS &quot; +&#xD;&#xA;&#x9;        &quot;FROM &quot; + raw + &quot;.ORDERS O JOIN &quot; + raw + &quot;.CUSTOMER C ON C.CUSTOMER_ID=O.CUSTOMER_ID WHERE O.ORDER_ID IS NOT NULL AND O.ORDER_AMOUNT>0 AND O.ORDER_DATE&lt;=CURRENT_DATE() &quot; +&#xD;&#xA;&#x9;        &quot;AND UPPER(COALESCE(O.ORDER_STATUS,'')) IN ('NEW','PAID','CANCELLED','REFUNDED') QUALIFY ROW_NUMBER() OVER(PARTITION BY O.ORDER_ID ORDER BY O.UPDATED_AT DESC NULLS LAST)=1) S &quot; +&#xD;&#xA;&#x9;        &quot;ON T.ORDER_ID=S.ORDER_ID WHEN MATCHED THEN UPDATE SET CUSTOMER_ID=S.CUSTOMER_ID,ORDER_DATE=S.ORDER_DATE,ORDER_AMOUNT=S.ORDER_AMOUNT,ORDER_STATUS=S.ORDER_STATUS,UPDATED_AT=S.UPDATED_AT,DQ_STATUS=S.DQ_STATUS,DQ_RUN_ID='&quot; + runId + &quot;',PROCESSED_AT=CURRENT_TIMESTAMP() &quot; +&#xD;&#xA;&#x9;        &quot;WHEN NOT MATCHED THEN INSERT (ORDER_ID,CUSTOMER_ID,ORDER_DATE,ORDER_AMOUNT,ORDER_STATUS,UPDATED_AT,DQ_STATUS,DQ_RUN_ID,PROCESSED_AT) VALUES (S.ORDER_ID,S.CUSTOMER_ID,S.ORDER_DATE,S.ORDER_AMOUNT,S.ORDER_STATUS,S.UPDATED_AT,S.DQ_STATUS,'&quot; + runId + &quot;',CURRENT_TIMESTAMP())&quot;&#xD;&#xA;&#x9;    );&#xD;&#xA;&#xD;&#xA;&#x9;    java.util.List&lt;String> paymentRules = java.util.Arrays.asList(&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','PAYMENTS',COALESCE(TO_VARCHAR(P.PAYMENT_ID),'&lt;NULL>'),'PAYMENT_KEY_REQUIRED','PAYMENT_ID is mandatory','CRITICAL','PAYMENT_ID',TO_VARCHAR(P.PAYMENT_ID),CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + raw + &quot;.PAYMENTS P WHERE P.PAYMENT_ID IS NULL&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','PAYMENTS',TO_VARCHAR(PAYMENT_ID),'PAYMENT_DUPLICATE_KEY','PAYMENT_ID must be unique','CRITICAL','PAYMENT_ID',TO_VARCHAR(PAYMENT_ID),CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + raw + &quot;.PAYMENTS QUALIFY COUNT(*) OVER (PARTITION BY PAYMENT_ID)>1&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','PAYMENTS',TO_VARCHAR(P.PAYMENT_ID),'PAYMENT_ORPHAN_ORDER','Payment order does not exist','CRITICAL','ORDER_ID',TO_VARCHAR(P.ORDER_ID),CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + raw + &quot;.PAYMENTS P LEFT JOIN &quot; + raw + &quot;.ORDERS O ON O.ORDER_ID=P.ORDER_ID WHERE O.ORDER_ID IS NULL&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','PAYMENTS',TO_VARCHAR(PAYMENT_ID),'PAYMENT_AMOUNT_POSITIVE','PAYMENT_AMOUNT must be greater than zero','CRITICAL','PAYMENT_AMOUNT',TO_VARCHAR(PAYMENT_AMOUNT),CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + raw + &quot;.PAYMENTS WHERE PAYMENT_AMOUNT IS NULL OR PAYMENT_AMOUNT&lt;=0&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','PAYMENTS',TO_VARCHAR(PAYMENT_ID),'PAYMENT_INVALID_METHOD','Payment method is outside the approved domain','MAJOR','PAYMENT_METHOD',PAYMENT_METHOD,CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + raw + &quot;.PAYMENTS WHERE UPPER(COALESCE(PAYMENT_METHOD,'')) NOT IN ('CARD','UPI','BANK_TRANSFER','CASH')&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','PAYMENTS',TO_VARCHAR(PAYMENT_ID),'PAYMENT_INVALID_STATUS','Payment status is outside the approved domain','MAJOR','PAYMENT_STATUS',PAYMENT_STATUS,CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + raw + &quot;.PAYMENTS WHERE UPPER(COALESCE(PAYMENT_STATUS,'')) NOT IN ('SUCCESS','FAILED','PENDING','REFUNDED')&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','PAYMENTS',TO_VARCHAR(P.PAYMENT_ID),'PAYMENT_BEFORE_ORDER','Payment date cannot precede order date','MAJOR','PAYMENT_DATE',TO_VARCHAR(P.PAYMENT_DATE),CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + raw + &quot;.PAYMENTS P JOIN &quot; + raw + &quot;.ORDERS O ON O.ORDER_ID=P.ORDER_ID WHERE TO_DATE(P.PAYMENT_DATE)&lt;O.ORDER_DATE&quot;&#xD;&#xA;&#x9;    );&#xD;&#xA;&#x9;    for (String sql : paymentRules) st.executeUpdate(sql);&#xD;&#xA;&#xD;&#xA;&#x9;    st.executeUpdate(&#xD;&#xA;&#x9;        &quot;MERGE INTO &quot; + curated + &quot;.PAYMENTS T USING (SELECT P.PAYMENT_ID,P.ORDER_ID,P.PAYMENT_DATE,P.PAYMENT_AMOUNT,UPPER(P.PAYMENT_METHOD) PAYMENT_METHOD,UPPER(P.PAYMENT_STATUS) PAYMENT_STATUS,P.UPDATED_AT,'PASSED' DQ_STATUS &quot; +&#xD;&#xA;&#x9;        &quot;FROM &quot; + raw + &quot;.PAYMENTS P JOIN &quot; + raw + &quot;.ORDERS O ON O.ORDER_ID=P.ORDER_ID WHERE P.PAYMENT_ID IS NOT NULL AND P.PAYMENT_AMOUNT>0 AND TO_DATE(P.PAYMENT_DATE)>=O.ORDER_DATE &quot; +&#xD;&#xA;&#x9;        &quot;AND UPPER(COALESCE(P.PAYMENT_METHOD,'')) IN ('CARD','UPI','BANK_TRANSFER','CASH') AND UPPER(COALESCE(P.PAYMENT_STATUS,'')) IN ('SUCCESS','FAILED','PENDING','REFUNDED') &quot; +&#xD;&#xA;&#x9;        &quot;QUALIFY ROW_NUMBER() OVER(PARTITION BY P.PAYMENT_ID ORDER BY P.UPDATED_AT DESC NULLS LAST)=1) S ON T.PAYMENT_ID=S.PAYMENT_ID &quot; +&#xD;&#xA;&#x9;        &quot;WHEN MATCHED THEN UPDATE SET ORDER_ID=S.ORDER_ID,PAYMENT_DATE=S.PAYMENT_DATE,PAYMENT_AMOUNT=S.PAYMENT_AMOUNT,PAYMENT_METHOD=S.PAYMENT_METHOD,PAYMENT_STATUS=S.PAYMENT_STATUS,UPDATED_AT=S.UPDATED_AT,DQ_STATUS=S.DQ_STATUS,DQ_RUN_ID='&quot; + runId + &quot;',PROCESSED_AT=CURRENT_TIMESTAMP() &quot; +&#xD;&#xA;&#x9;        &quot;WHEN NOT MATCHED THEN INSERT (PAYMENT_ID,ORDER_ID,PAYMENT_DATE,PAYMENT_AMOUNT,PAYMENT_METHOD,PAYMENT_STATUS,UPDATED_AT,DQ_STATUS,DQ_RUN_ID,PROCESSED_AT) VALUES (S.PAYMENT_ID,S.ORDER_ID,S.PAYMENT_DATE,S.PAYMENT_AMOUNT,S.PAYMENT_METHOD,S.PAYMENT_STATUS,S.UPDATED_AT,S.DQ_STATUS,'&quot; + runId + &quot;',CURRENT_TIMESTAMP())&quot;&#xD;&#xA;&#x9;    );&#xD;&#xA;&#xD;&#xA;&#x9;    st.executeUpdate(&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','ORDER_PAYMENT_BALANCE',TO_VARCHAR(O.ORDER_ID),'PAYMENT_OVER_ORDER_AMOUNT','Successful payment total exceeds order amount','MAJOR','PAYMENT_AMOUNT',TO_VARCHAR(SUM(P.PAYMENT_AMOUNT)-MAX(O.ORDER_AMOUNT)),CURRENT_TIMESTAMP(),'OPEN' &quot; +&#xD;&#xA;&#x9;        &quot;FROM &quot; + raw + &quot;.ORDERS O JOIN &quot; + raw + &quot;.PAYMENTS P ON P.ORDER_ID=O.ORDER_ID AND UPPER(P.PAYMENT_STATUS)='SUCCESS' GROUP BY O.ORDER_ID HAVING SUM(P.PAYMENT_AMOUNT)>MAX(O.ORDER_AMOUNT)&quot;&#xD;&#xA;&#x9;    );&#xD;&#xA;&#xD;&#xA;&#x9;    // CURATED represents the current accepted state. Remove rows deleted from RAW or&#xD;&#xA;&#x9;    // rows that became invalid in this run, processing children before parents.&#xD;&#xA;&#x9;    st.executeUpdate(&quot;DELETE FROM &quot; + curated + &quot;.PAYMENTS WHERE DQ_RUN_ID IS NULL OR DQ_RUN_ID&lt;>'&quot; + runId + &quot;'&quot;);&#xD;&#xA;&#x9;    st.executeUpdate(&quot;DELETE FROM &quot; + curated + &quot;.ORDERS WHERE DQ_RUN_ID IS NULL OR DQ_RUN_ID&lt;>'&quot; + runId + &quot;'&quot;);&#xD;&#xA;&#x9;    st.executeUpdate(&quot;DELETE FROM &quot; + curated + &quot;.CUSTOMER WHERE DQ_RUN_ID IS NULL OR DQ_RUN_ID&lt;>'&quot; + runId + &quot;'&quot;);&#xD;&#xA;&#xD;&#xA;&#x9;    st.executeUpdate(&#xD;&#xA;&#x9;        &quot;UPDATE &quot; + control + &quot;.DQ_RUN SET END_TS=CURRENT_TIMESTAMP(),&quot; +&#xD;&#xA;&#x9;        &quot;ROWS_READ=(SELECT COUNT(*) FROM &quot; + raw + &quot;.CUSTOMER)+(SELECT COUNT(*) FROM &quot; + raw + &quot;.ORDERS)+(SELECT COUNT(*) FROM &quot; + raw + &quot;.PAYMENTS),&quot; +&#xD;&#xA;&#x9;        &quot;ROWS_PASSED=(SELECT COUNT(*) FROM &quot; + curated + &quot;.CUSTOMER WHERE DQ_RUN_ID='&quot; + runId + &quot;')+(SELECT COUNT(*) FROM &quot; + curated + &quot;.ORDERS WHERE DQ_RUN_ID='&quot; + runId + &quot;')+(SELECT COUNT(*) FROM &quot; + curated + &quot;.PAYMENTS WHERE DQ_RUN_ID='&quot; + runId + &quot;'),&quot; +&#xD;&#xA;&#x9;        &quot;ROWS_REJECTED=(SELECT COUNT(DISTINCT ENTITY_NAME||'|'||RECORD_KEY) FROM &quot; + exception + &quot;.DQ_EXCEPTION WHERE RUN_ID='&quot; + runId + &quot;' AND ENTITY_NAME IN ('CUSTOMER','ORDERS','PAYMENTS') AND SEVERITY IN ('CRITICAL','MAJOR')),&quot; +&#xD;&#xA;&#x9;        &quot;STATUS=CASE WHEN (SELECT COUNT(*) FROM &quot; + exception + &quot;.DQ_EXCEPTION WHERE RUN_ID='&quot; + runId + &quot;' AND SEVERITY IN ('CRITICAL','MAJOR'))>0 THEN 'COMPLETED_WITH_EXCEPTIONS' WHEN (SELECT COUNT(*) FROM &quot; + exception + &quot;.DQ_EXCEPTION WHERE RUN_ID='&quot; + runId + &quot;')>0 THEN 'COMPLETED_WITH_WARNINGS' ELSE 'COMPLETED' END &quot; +&#xD;&#xA;&#x9;        &quot;WHERE RUN_ID='&quot; + runId + &quot;'&quot;&#xD;&#xA;&#x9;    );&#xD;&#xA;&#x9;    sf.commit();&#xD;&#xA;&#x9;    System.out.println(&quot;DQ run completed: &quot; + context.run_id);&#xD;&#xA;&#x9;} catch (Exception e) {&#xD;&#xA;&#x9;    try { sf.rollback(); } catch (Exception ignored) {}&#xD;&#xA;&#x9;    try {&#xD;&#xA;&#x9;        sf.setAutoCommit(true);&#xD;&#xA;&#x9;        try (java.sql.PreparedStatement ps = sf.prepareStatement(&quot;INSERT INTO &quot; + control + &quot;.DQ_RUN (RUN_ID,JOB_NAME,ENVIRONMENT,START_TS,END_TS,STATUS,ERROR_MESSAGE) VALUES (?,?,?,CURRENT_TIMESTAMP(),CURRENT_TIMESTAMP(),'FAILED',?)&quot;)) {&#xD;&#xA;&#x9;            ps.setString(1, context.run_id);&#xD;&#xA;&#x9;            ps.setString(2, &quot;MJ_QTC_STORAGE_TO_CURATED_DQ&quot;);&#xD;&#xA;&#x9;            ps.setString(3, context.environment);&#xD;&#xA;&#x9;            ps.setString(4, e.getMessage());&#xD;&#xA;&#x9;            ps.executeUpdate();&#xD;&#xA;&#x9;        }&#xD;&#xA;&#x9;    } catch (Exception auditError) {&#xD;&#xA;&#x9;        System.err.println(&quot;Unable to record DQ failure: &quot; + auditError.getMessage());&#xD;&#xA;&#x9;    }&#xD;&#xA;&#x9;    throw new RuntimeException(&quot;DQ Job failed for run &quot; + context.run_id, e);&#xD;&#xA;&#x9;} finally {&#xD;&#xA;&#x9;    // Only close the connection here if we opened it ourselves in the fallback path.&#xD;&#xA;&#x9;    // If it came from the wired tSnowflakeConnection component, let Studio's own&#xD;&#xA;&#x9;    // tSnowflakeClose/tPostjob manage its lifecycle instead.&#xD;&#xA;&#x9;    if (ownsConnection &amp;&amp; sf != null) {&#xD;&#xA;&#x9;        try {&#xD;&#xA;&#x9;            sf.close();&#xD;&#xA;&#x9;            globalMap.put(&quot;conn_tSnowflakeConnection_1&quot;, null);&#xD;&#xA;&#x9;        } catch (Exception closeEx) {&#xD;&#xA;&#x9;            System.err.println(&quot;Failed to close fallback Snowflake connection: &quot; + closeEx.getMessage());&#xD;&#xA;&#x9;        }&#xD;&#xA;&#x9;    }&#xD;&#xA;&#x9;}"/>
