    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="String[] identifiers = {&#xD;&#xA;&#x9;    context.sf_database, context.sf_qtc_storage_schema, context.sf_curated_schema,&#xD;&#xA;&#x9;    context.sf_control_schema, context.sf_exception_schema&#xD;&#xA;&#x9;};&#xD;&#xA;&#x9;for (String identifier : identifiers) {&#xD;&#xA;&#x9;    if (identifier == null || !identifier.matches(&quot;[A-Za-z_][A-Za-z0-9_$]*&quot;)) {&#xD;&#xA;&#x9;        throw new IllegalArgumentException(&quot;Unsafe or empty Snowflake identifier: &quot; + identifier);&#xD;&#xA;&#x9;    }&#xD;&#xA;&#x9;}&#xD;&#xA; &#xD;&#xA;&#x9;// Quote every identifier to preserve exact case. The raw/storage schema and its&#xD;&#xA;&#x9;// tables/columns were created case-sensitive lowercase by the ingestion pipeline&#xD;&#xA;&#x9;// (e.g. &quot;mysql_to_snowflake_demo_storage&quot;.&quot;customer&quot;.&quot;customer_id&quot;), so every&#xD;&#xA;&#x9;// reference into that schema must be quoted lowercase or Snowflake folds it to&#xD;&#xA;&#x9;// uppercase and the object &quot;doesn't exist&quot;.&#xD;&#xA;&#x9;final java.util.function.Function&lt;String, String> q = s -> &quot;\&quot;&quot; + s.replace(&quot;\&quot;&quot;, &quot;\&quot;\&quot;&quot;) + &quot;\&quot;&quot;;&#xD;&#xA; &#xD;&#xA;&#x9;final String db = q.apply(context.sf_database);&#xD;&#xA;&#x9;final String raw = db + &quot;.&quot; + q.apply(context.sf_qtc_storage_schema);&#xD;&#xA;&#x9;final String curated = db + &quot;.&quot; + q.apply(context.sf_curated_schema);&#xD;&#xA;&#x9;final String control = db + &quot;.&quot; + q.apply(context.sf_control_schema);&#xD;&#xA;&#x9;final String exception = db + &quot;.&quot; + q.apply(context.sf_exception_schema);&#xD;&#xA;&#x9;final String runId = context.run_id.replace(&quot;'&quot;, &quot;''&quot;);&#xD;&#xA; &#xD;&#xA;&#x9;// Raw (source) table references - confirmed lowercase for CUSTOMER via query editor.&#xD;&#xA;&#x9;// ORDERS/PAYMENTS assumed to follow the same lowercase convention - verify with&#xD;&#xA;&#x9;// DESCRIBE TABLE and adjust the quoted names/columns below if different.&#xD;&#xA;&#x9;final String rawCustomer = raw + &quot;.\&quot;customer\&quot;&quot;;&#xD;&#xA;&#x9;final String rawOrders   = raw + &quot;.\&quot;orders\&quot;&quot;;&#xD;&#xA;&#x9;final String rawPayments = raw + &quot;.\&quot;payments\&quot;&quot;;&#xD;&#xA; &#xD;&#xA;&#x9;// --- Connection resolution ---&#xD;&#xA;&#x9;java.sql.Connection sf = (java.sql.Connection) globalMap.get(&quot;conn_tDBConnection_1&quot;);&#xD;&#xA;&#x9;boolean ownsConnection = false;&#xD;&#xA; &#xD;&#xA;&#x9;if (sf == null) {&#xD;&#xA;&#x9;    try {&#xD;&#xA;&#x9;        System.out.println(&quot;WARN: conn_tDBConnection_1 not found in globalMap. &quot;&#xD;&#xA;&#x9;            + &quot;Opening a direct fallback Snowflake connection.&quot;);&#xD;&#xA; &#xD;&#xA;&#x9;        if (context.sf_account == null || context.sf_account.isEmpty()) {&#xD;&#xA;&#x9;            throw new IllegalStateException(&quot;context.sf_account is required for the fallback connection but is empty.&quot;);&#xD;&#xA;&#x9;        }&#xD;&#xA;&#x9;        if (context.sf_user == null || context.sf_user.isEmpty()) {&#xD;&#xA;&#x9;            throw new IllegalStateException(&quot;context.sf_user is required for the fallback connection but is empty.&quot;);&#xD;&#xA;&#x9;        }&#xD;&#xA;&#x9;        if (context.sf_password == null || context.sf_password.isEmpty()) {&#xD;&#xA;&#x9;            throw new IllegalStateException(&quot;context.sf_password is required for the fallback connection but is empty.&quot;);&#xD;&#xA;&#x9;        }&#xD;&#xA;&#x9;        if (context.sf_warehouse == null || context.sf_warehouse.isEmpty()) {&#xD;&#xA;&#x9;            throw new IllegalStateException(&quot;context.sf_warehouse is required for the fallback connection but is empty.&quot;);&#xD;&#xA;&#x9;        }&#xD;&#xA; &#xD;&#xA;&#x9;        StringBuilder url = new StringBuilder(&quot;jdbc:snowflake://&quot;)&#xD;&#xA;&#x9;            .append(context.sf_account)&#xD;&#xA;&#x9;            .append(&quot;.snowflakecomputing.com/?db=&quot;).append(context.sf_database)&#xD;&#xA;&#x9;            .append(&quot;&amp;warehouse=&quot;).append(context.sf_warehouse);&#xD;&#xA;&#x9;        if (context.sf_role != null &amp;&amp; !context.sf_role.isEmpty()) {&#xD;&#xA;&#x9;            url.append(&quot;&amp;role=&quot;).append(context.sf_role);&#xD;&#xA;&#x9;        }&#xD;&#xA; &#xD;&#xA;&#x9;        java.util.Properties props = new java.util.Properties();&#xD;&#xA;&#x9;        props.put(&quot;user&quot;, context.sf_user);&#xD;&#xA;&#x9;        props.put(&quot;password&quot;, context.sf_password);&#xD;&#xA; &#xD;&#xA;&#x9;        Class.forName(&quot;net.snowflake.client.jdbc.SnowflakeDriver&quot;);&#xD;&#xA;&#x9;        sf = java.sql.DriverManager.getConnection(url.toString(), props);&#xD;&#xA;&#x9;        globalMap.put(&quot;conn_tDBConnection_1&quot;, sf);&#xD;&#xA;&#x9;        ownsConnection = true;&#xD;&#xA; &#xD;&#xA;&#x9;        System.out.println(&quot;Fallback Snowflake connection established.&quot;);&#xD;&#xA;&#x9;    } catch (Exception connEx) {&#xD;&#xA;&#x9;        throw new IllegalStateException(&quot;Snowflake connection is unavailable, and fallback connection failed: &quot;&#xD;&#xA;&#x9;            + connEx.getMessage(), connEx);&#xD;&#xA;&#x9;    }&#xD;&#xA;&#x9;}&#xD;&#xA; &#xD;&#xA;&#x9;sf.setAutoCommit(false);&#xD;&#xA;&#x9;try (java.sql.Statement st = sf.createStatement()) {&#xD;&#xA;&#x9;    java.util.List&lt;String> setup = java.util.Arrays.asList(&#xD;&#xA;&#x9;        &quot;CREATE SCHEMA IF NOT EXISTS &quot; + curated,&#xD;&#xA;&#x9;        &quot;CREATE SCHEMA IF NOT EXISTS &quot; + control,&#xD;&#xA;&#x9;        &quot;CREATE SCHEMA IF NOT EXISTS &quot; + exception,&#xD;&#xA;&#x9;        &quot;CREATE TABLE IF NOT EXISTS &quot; + control + &quot;.DQ_RUN (RUN_ID VARCHAR, JOB_NAME VARCHAR, ENVIRONMENT VARCHAR, START_TS TIMESTAMP_LTZ, END_TS TIMESTAMP_LTZ, STATUS VARCHAR, ROWS_READ NUMBER, ROWS_PASSED NUMBER, ROWS_REJECTED NUMBER, ERROR_MESSAGE VARCHAR)&quot;,&#xD;&#xA;&#x9;        &quot;CREATE TABLE IF NOT EXISTS &quot; + exception + &quot;.DQ_EXCEPTION (RUN_ID VARCHAR, ENTITY_NAME VARCHAR, RECORD_KEY VARCHAR, RULE_CODE VARCHAR, RULE_DESCRIPTION VARCHAR, SEVERITY VARCHAR, COLUMN_NAME VARCHAR, BAD_VALUE VARCHAR, DETECTED_AT TIMESTAMP_LTZ, RESOLUTION_STATUS VARCHAR)&quot;,&#xD;&#xA;&#x9;        &quot;CREATE TABLE IF NOT EXISTS &quot; + curated + &quot;.CUSTOMER (CUSTOMER_ID NUMBER(38,0), CUSTOMER_NAME VARCHAR, EMAIL VARCHAR, PHONE VARCHAR, STATUS VARCHAR, UPDATED_AT TIMESTAMP_NTZ, DQ_STATUS VARCHAR, DQ_RUN_ID VARCHAR, PROCESSED_AT TIMESTAMP_LTZ)&quot;,&#xD;&#xA;&#x9;        &quot;CREATE TABLE IF NOT EXISTS &quot; + curated + &quot;.ORDERS (ORDER_ID NUMBER(38,0), CUSTOMER_ID NUMBER(38,0), ORDER_DATE DATE, ORDER_AMOUNT NUMBER(18,2), ORDER_STATUS VARCHAR, UPDATED_AT TIMESTAMP_NTZ, DQ_STATUS VARCHAR, DQ_RUN_ID VARCHAR, PROCESSED_AT TIMESTAMP_LTZ)&quot;,&#xD;&#xA;&#x9;        &quot;CREATE TABLE IF NOT EXISTS &quot; + curated + &quot;.PAYMENTS (PAYMENT_ID NUMBER(38,0), ORDER_ID NUMBER(38,0), PAYMENT_DATE TIMESTAMP_NTZ, PAYMENT_AMOUNT NUMBER(18,2), PAYMENT_METHOD VARCHAR, PAYMENT_STATUS VARCHAR, UPDATED_AT TIMESTAMP_NTZ, DQ_STATUS VARCHAR, DQ_RUN_ID VARCHAR, PROCESSED_AT TIMESTAMP_LTZ)&quot;,&#xD;&#xA;&#x9;        &quot;CREATE OR REPLACE VIEW &quot; + control + &quot;.DQ_EXCEPTION_VW AS SELECT E.*,CASE WHEN E.ENTITY_NAME='CUSTOMER' THEN 'Customer Data Steward' WHEN E.ENTITY_NAME='ORDERS' THEN 'Order Operations' WHEN E.ENTITY_NAME='PAYMENTS' THEN 'Payment Operations' ELSE 'Data Quality Team' END AS OWNER FROM &quot; + exception + &quot;.DQ_EXCEPTION E&quot;&#xD;&#xA;&#x9;    );&#xD;&#xA;&#x9;    for (String sql : setup) st.execute(sql);&#xD;&#xA; &#xD;&#xA;&#x9;    st.executeUpdate(&quot;DELETE FROM &quot; + exception + &quot;.DQ_EXCEPTION WHERE RUN_ID='&quot; + runId + &quot;'&quot;);&#xD;&#xA;&#x9;    st.executeUpdate(&quot;DELETE FROM &quot; + control + &quot;.DQ_RUN WHERE RUN_ID='&quot; + runId + &quot;'&quot;);&#xD;&#xA;&#x9;    st.executeUpdate(&quot;INSERT INTO &quot; + control + &quot;.DQ_RUN (RUN_ID,JOB_NAME,ENVIRONMENT,START_TS,STATUS) VALUES ('&quot; + runId + &quot;','MJ_QTC_STORAGE_TO_CURATED_DQ','&quot; + context.environment.replace(&quot;'&quot;, &quot;''&quot;) + &quot;',CURRENT_TIMESTAMP(),'RUNNING')&quot;);&#xD;&#xA; &#xD;&#xA;&#x9;    // ===================== CUSTOMER =====================&#xD;&#xA;&#x9;    java.util.List&lt;String> customerRules = java.util.Arrays.asList(&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','CUSTOMER',COALESCE(TO_VARCHAR(\&quot;customer_id\&quot;),'&lt;NULL>'),'CUST_KEY_REQUIRED','CUSTOMER_ID is mandatory','CRITICAL','CUSTOMER_ID',TO_VARCHAR(\&quot;customer_id\&quot;),CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + rawCustomer + &quot; WHERE \&quot;customer_id\&quot; IS NULL&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','CUSTOMER',TO_VARCHAR(\&quot;customer_id\&quot;),'CUST_DUPLICATE_KEY','CUSTOMER_ID must be unique','CRITICAL','CUSTOMER_ID',TO_VARCHAR(\&quot;customer_id\&quot;),CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + rawCustomer + &quot; QUALIFY COUNT(*) OVER (PARTITION BY \&quot;customer_id\&quot;)>1&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','CUSTOMER',TO_VARCHAR(\&quot;customer_id\&quot;),'CUST_NAME_REQUIRED','Customer name cannot be blank','MAJOR','CUSTOMER_NAME',\&quot;customer_name\&quot;,CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + rawCustomer + &quot; WHERE NULLIF(TRIM(\&quot;customer_name\&quot;),'') IS NULL&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','CUSTOMER',TO_VARCHAR(\&quot;customer_id\&quot;),'CUST_INVALID_STATUS','Customer status is outside the approved domain','MAJOR','STATUS',\&quot;customer_status\&quot;,CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + rawCustomer + &quot; WHERE UPPER(COALESCE(\&quot;customer_status\&quot;,'')) NOT IN ('ACTIVE','INACTIVE','SUSPENDED')&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','CUSTOMER',TO_VARCHAR(\&quot;customer_id\&quot;),'CUST_INVALID_EMAIL','Email is missing or does not match the approved pattern','MAJOR','EMAIL',\&quot;email\&quot;,CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + rawCustomer + &quot; WHERE \&quot;email\&quot; IS NULL OR NOT REGEXP_LIKE(\&quot;email\&quot;,'^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+[.][A-Za-z]{2,}$')&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','CUSTOMER',TO_VARCHAR(\&quot;customer_id\&quot;),'CUST_INVALID_PHONE','Phone is missing or does not match the approved pattern','MAJOR','PHONE',\&quot;phone\&quot;,CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + rawCustomer + &quot; WHERE \&quot;phone\&quot; IS NULL OR NOT REGEXP_LIKE(\&quot;phone\&quot;,'^[0-9+() .-]{7,20}$')&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','CUSTOMER',TO_VARCHAR(\&quot;customer_id\&quot;),'CUST_DUPLICATE_CONTACT','Duplicate email and phone combination requires review','WARNING','EMAIL_PHONE',\&quot;email\&quot;||'|'||\&quot;phone\&quot;,CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + rawCustomer + &quot; WHERE \&quot;email\&quot; IS NOT NULL AND \&quot;phone\&quot; IS NOT NULL QUALIFY COUNT(*) OVER (PARTITION BY LOWER(TRIM(\&quot;email\&quot;)),REGEXP_REPLACE(\&quot;phone\&quot;,'[^0-9]',''))>1&quot;&#xD;&#xA;&#x9;    );&#xD;&#xA;&#x9;    for (String sql : customerRules) st.executeUpdate(sql);&#xD;&#xA; &#xD;&#xA;&#x9;    // FIX: the source subquery's STATUS alias collided with Snowflake's identifier&#xD;&#xA;&#x9;    // resolution inside the MERGE ... WHEN MATCHED SET clause (&quot;invalid identifier&#xD;&#xA;&#x9;    // 'STATUS'&quot;). Renamed the source alias to CUST_STATUS so there is no longer any&#xD;&#xA;&#x9;    // column literally named STATUS anywhere in the USING(...) subquery; the target&#xD;&#xA;&#x9;    // table's STATUS column is still written via T.STATUS=S.CUST_STATUS.&#xD;&#xA;&#x9;    st.executeUpdate(&#xD;&#xA;&#x9;        &quot;MERGE INTO &quot; + curated + &quot;.CUSTOMER T USING (&quot; +&#xD;&#xA;&#x9;        &quot;SELECT \&quot;customer_id\&quot; CUSTOMER_ID,\&quot;customer_name\&quot; CUSTOMER_NAME,\&quot;email\&quot; EMAIL,\&quot;phone\&quot; PHONE,UPPER(\&quot;customer_status\&quot;) CUST_STATUS,\&quot;updated_at\&quot; UPDATED_AT,&quot; +&#xD;&#xA;&#x9;        &quot;CASE WHEN COUNT(*) OVER (PARTITION BY LOWER(TRIM(\&quot;email\&quot;)),REGEXP_REPLACE(\&quot;phone\&quot;,'[^0-9]',''))>1 THEN 'WARNING' ELSE 'PASSED' END DQ_STATUS &quot; +&#xD;&#xA;&#x9;        &quot;FROM &quot; + rawCustomer + &quot; WHERE \&quot;customer_id\&quot; IS NOT NULL &quot; +&#xD;&#xA;&#x9;        &quot;AND UPPER(COALESCE(\&quot;customer_status\&quot;,'')) IN ('ACTIVE','INACTIVE','SUSPENDED') &quot; +&#xD;&#xA;&#x9;        &quot;AND NULLIF(TRIM(\&quot;customer_name\&quot;),'') IS NOT NULL &quot; +&#xD;&#xA;&#x9;        &quot;AND \&quot;email\&quot; IS NOT NULL AND REGEXP_LIKE(\&quot;email\&quot;,'^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+[.][A-Za-z]{2,}$') &quot; +&#xD;&#xA;&#x9;        &quot;AND \&quot;phone\&quot; IS NOT NULL AND REGEXP_LIKE(\&quot;phone\&quot;,'^[0-9+() .-]{7,20}$') &quot; +&#xD;&#xA;&#x9;        &quot;QUALIFY ROW_NUMBER() OVER(PARTITION BY \&quot;customer_id\&quot; ORDER BY \&quot;updated_at\&quot; DESC NULLS LAST)=1) S &quot; +&#xD;&#xA;&#x9;        &quot;ON T.CUSTOMER_ID=S.CUSTOMER_ID WHEN MATCHED THEN UPDATE SET T.CUSTOMER_NAME=S.CUSTOMER_NAME,T.EMAIL=S.EMAIL,T.PHONE=S.PHONE,T.STATUS=S.CUST_STATUS,T.UPDATED_AT=S.UPDATED_AT,T.DQ_STATUS=S.DQ_STATUS,T.DQ_RUN_ID='&quot; + runId + &quot;',T.PROCESSED_AT=CURRENT_TIMESTAMP() &quot; +&#xD;&#xA;&#x9;        &quot;WHEN NOT MATCHED THEN INSERT (CUSTOMER_ID,CUSTOMER_NAME,EMAIL,PHONE,STATUS,UPDATED_AT,DQ_STATUS,DQ_RUN_ID,PROCESSED_AT) VALUES (S.CUSTOMER_ID,S.CUSTOMER_NAME,S.EMAIL,S.PHONE,S.CUST_STATUS,S.UPDATED_AT,S.DQ_STATUS,'&quot; + runId + &quot;',CURRENT_TIMESTAMP())&quot;&#xD;&#xA;&#x9;    );&#xD;&#xA; &#xD;&#xA;&#x9;    // ===================== ORDERS =====================&#xD;&#xA;&#x9;    // ASSUMPTION: columns order_id, customer_id, order_date, order_amount, order_status, updated_at&#xD;&#xA;&#x9;    // — verify against DESCRIBE TABLE and rename below if different.&#xD;&#xA;&#x9;    java.util.List&lt;String> orderRules = java.util.Arrays.asList(&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','ORDERS',COALESCE(TO_VARCHAR(O.\&quot;order_id\&quot;),'&lt;NULL>'),'ORDER_KEY_REQUIRED','ORDER_ID is mandatory','CRITICAL','ORDER_ID',TO_VARCHAR(O.\&quot;order_id\&quot;),CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + rawOrders + &quot; O WHERE O.\&quot;order_id\&quot; IS NULL&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','ORDERS',TO_VARCHAR(\&quot;order_id\&quot;),'ORDER_DUPLICATE_KEY','ORDER_ID must be unique','CRITICAL','ORDER_ID',TO_VARCHAR(\&quot;order_id\&quot;),CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + rawOrders + &quot; QUALIFY COUNT(*) OVER (PARTITION BY \&quot;order_id\&quot;)>1&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','ORDERS',TO_VARCHAR(O.\&quot;order_id\&quot;),'ORDER_ORPHAN_CUSTOMER','Order customer does not exist','CRITICAL','CUSTOMER_ID',TO_VARCHAR(O.\&quot;customer_id\&quot;),CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + rawOrders + &quot; O LEFT JOIN &quot; + rawCustomer + &quot; C ON C.\&quot;customer_id\&quot;=O.\&quot;customer_id\&quot; WHERE C.\&quot;customer_id\&quot; IS NULL&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','ORDERS',TO_VARCHAR(\&quot;order_id\&quot;),'ORDER_AMOUNT_POSITIVE','ORDER_AMOUNT must be greater than zero','CRITICAL','ORDER_AMOUNT',TO_VARCHAR(\&quot;order_amount\&quot;),CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + rawOrders + &quot; WHERE \&quot;order_amount\&quot; IS NULL OR \&quot;order_amount\&quot;&lt;=0&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','ORDERS',TO_VARCHAR(\&quot;order_id\&quot;),'ORDER_INVALID_STATUS','Order status is outside the approved domain','MAJOR','ORDER_STATUS',\&quot;order_status\&quot;,CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + rawOrders + &quot; WHERE UPPER(COALESCE(\&quot;order_status\&quot;,'')) NOT IN ('NEW','PAID','CANCELLED','REFUNDED')&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','ORDERS',TO_VARCHAR(\&quot;order_id\&quot;),'ORDER_INVALID_DATE','ORDER_DATE is mandatory and cannot be in the future','MAJOR','ORDER_DATE',TO_VARCHAR(\&quot;order_date\&quot;),CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + rawOrders + &quot; WHERE \&quot;order_date\&quot; IS NULL OR \&quot;order_date\&quot;>CURRENT_DATE()&quot;&#xD;&#xA;&#x9;    );&#xD;&#xA;&#x9;    for (String sql : orderRules) st.executeUpdate(sql);&#xD;&#xA; &#xD;&#xA;&#x9;    st.executeUpdate(&#xD;&#xA;&#x9;        &quot;MERGE INTO &quot; + curated + &quot;.ORDERS T USING (SELECT O.\&quot;order_id\&quot; ORDER_ID,O.\&quot;customer_id\&quot; CUSTOMER_ID,O.\&quot;order_date\&quot; ORDER_DATE,O.\&quot;order_amount\&quot; ORDER_AMOUNT,UPPER(O.\&quot;order_status\&quot;) ORDER_STATUS,O.\&quot;updated_at\&quot; UPDATED_AT,'PASSED' DQ_STATUS &quot; +&#xD;&#xA;&#x9;        &quot;FROM &quot; + rawOrders + &quot; O JOIN &quot; + rawCustomer + &quot; C ON C.\&quot;customer_id\&quot;=O.\&quot;customer_id\&quot; WHERE O.\&quot;order_id\&quot; IS NOT NULL AND O.\&quot;order_amount\&quot;>0 AND O.\&quot;order_date\&quot;&lt;=CURRENT_DATE() &quot; +&#xD;&#xA;&#x9;        &quot;AND UPPER(COALESCE(O.\&quot;order_status\&quot;,'')) IN ('NEW','PAID','CANCELLED','REFUNDED') QUALIFY ROW_NUMBER() OVER(PARTITION BY O.\&quot;order_id\&quot; ORDER BY O.\&quot;updated_at\&quot; DESC NULLS LAST)=1) S &quot; +&#xD;&#xA;&#x9;        &quot;ON T.ORDER_ID=S.ORDER_ID WHEN MATCHED THEN UPDATE SET T.CUSTOMER_ID=S.CUSTOMER_ID,T.ORDER_DATE=S.ORDER_DATE,T.ORDER_AMOUNT=S.ORDER_AMOUNT,T.ORDER_STATUS=S.ORDER_STATUS,T.UPDATED_AT=S.UPDATED_AT,T.DQ_STATUS=S.DQ_STATUS,T.DQ_RUN_ID='&quot; + runId + &quot;',T.PROCESSED_AT=CURRENT_TIMESTAMP() &quot; +&#xD;&#xA;&#x9;        &quot;WHEN NOT MATCHED THEN INSERT (ORDER_ID,CUSTOMER_ID,ORDER_DATE,ORDER_AMOUNT,ORDER_STATUS,UPDATED_AT,DQ_STATUS,DQ_RUN_ID,PROCESSED_AT) VALUES (S.ORDER_ID,S.CUSTOMER_ID,S.ORDER_DATE,S.ORDER_AMOUNT,S.ORDER_STATUS,S.UPDATED_AT,S.DQ_STATUS,'&quot; + runId + &quot;',CURRENT_TIMESTAMP())&quot;&#xD;&#xA;&#x9;    );&#xD;&#xA; &#xD;&#xA;&#x9;    // ===================== PAYMENTS =====================&#xD;&#xA;&#x9;    // ASSUMPTION: columns payment_id, order_id, payment_date, payment_amount, payment_method,&#xD;&#xA;&#x9;    // payment_status, updated_at — verify against DESCRIBE TABLE and rename below if different.&#xD;&#xA;&#x9;    java.util.List&lt;String> paymentRules = java.util.Arrays.asList(&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','PAYMENTS',COALESCE(TO_VARCHAR(P.\&quot;payment_id\&quot;),'&lt;NULL>'),'PAYMENT_KEY_REQUIRED','PAYMENT_ID is mandatory','CRITICAL','PAYMENT_ID',TO_VARCHAR(P.\&quot;payment_id\&quot;),CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + rawPayments + &quot; P WHERE P.\&quot;payment_id\&quot; IS NULL&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','PAYMENTS',TO_VARCHAR(\&quot;payment_id\&quot;),'PAYMENT_DUPLICATE_KEY','PAYMENT_ID must be unique','CRITICAL','PAYMENT_ID',TO_VARCHAR(\&quot;payment_id\&quot;),CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + rawPayments + &quot; QUALIFY COUNT(*) OVER (PARTITION BY \&quot;payment_id\&quot;)>1&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','PAYMENTS',TO_VARCHAR(P.\&quot;payment_id\&quot;),'PAYMENT_ORPHAN_ORDER','Payment order does not exist','CRITICAL','ORDER_ID',TO_VARCHAR(P.\&quot;order_id\&quot;),CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + rawPayments + &quot; P LEFT JOIN &quot; + rawOrders + &quot; O ON O.\&quot;order_id\&quot;=P.\&quot;order_id\&quot; WHERE O.\&quot;order_id\&quot; IS NULL&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','PAYMENTS',TO_VARCHAR(\&quot;payment_id\&quot;),'PAYMENT_AMOUNT_POSITIVE','PAYMENT_AMOUNT must be greater than zero','CRITICAL','PAYMENT_AMOUNT',TO_VARCHAR(\&quot;payment_amount\&quot;),CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + rawPayments + &quot; WHERE \&quot;payment_amount\&quot; IS NULL OR \&quot;payment_amount\&quot;&lt;=0&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','PAYMENTS',TO_VARCHAR(\&quot;payment_id\&quot;),'PAYMENT_INVALID_METHOD','Payment method is outside the approved domain','MAJOR','PAYMENT_METHOD',\&quot;payment_method\&quot;,CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + rawPayments + &quot; WHERE UPPER(COALESCE(\&quot;payment_method\&quot;,'')) NOT IN ('CARD','UPI','BANK_TRANSFER','CASH')&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','PAYMENTS',TO_VARCHAR(\&quot;payment_id\&quot;),'PAYMENT_INVALID_STATUS','Payment status is outside the approved domain','MAJOR','PAYMENT_STATUS',\&quot;payment_status\&quot;,CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + rawPayments + &quot; WHERE UPPER(COALESCE(\&quot;payment_status\&quot;,'')) NOT IN ('SUCCESS','FAILED','PENDING','REFUNDED')&quot;,&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','PAYMENTS',TO_VARCHAR(P.\&quot;payment_id\&quot;),'PAYMENT_BEFORE_ORDER','Payment date cannot precede order date','MAJOR','PAYMENT_DATE',TO_VARCHAR(P.\&quot;payment_date\&quot;),CURRENT_TIMESTAMP(),'OPEN' FROM &quot; + rawPayments + &quot; P JOIN &quot; + rawOrders + &quot; O ON O.\&quot;order_id\&quot;=P.\&quot;order_id\&quot; WHERE TO_DATE(P.\&quot;payment_date\&quot;)&lt;O.\&quot;order_date\&quot;&quot;&#xD;&#xA;&#x9;    );&#xD;&#xA;&#x9;    for (String sql : paymentRules) st.executeUpdate(sql);&#xD;&#xA; &#xD;&#xA;&#x9;    st.executeUpdate(&#xD;&#xA;&#x9;        &quot;MERGE INTO &quot; + curated + &quot;.PAYMENTS T USING (SELECT P.\&quot;payment_id\&quot; PAYMENT_ID,P.\&quot;order_id\&quot; ORDER_ID,P.\&quot;payment_date\&quot; PAYMENT_DATE,P.\&quot;payment_amount\&quot; PAYMENT_AMOUNT,UPPER(P.\&quot;payment_method\&quot;) PAYMENT_METHOD,UPPER(P.\&quot;payment_status\&quot;) PAYMENT_STATUS,P.\&quot;updated_at\&quot; UPDATED_AT,'PASSED' DQ_STATUS &quot; +&#xD;&#xA;&#x9;        &quot;FROM &quot; + rawPayments + &quot; P JOIN &quot; + rawOrders + &quot; O ON O.\&quot;order_id\&quot;=P.\&quot;order_id\&quot; WHERE P.\&quot;payment_id\&quot; IS NOT NULL AND P.\&quot;payment_amount\&quot;>0 AND TO_DATE(P.\&quot;payment_date\&quot;)>=O.\&quot;order_date\&quot; &quot; +&#xD;&#xA;&#x9;        &quot;AND UPPER(COALESCE(P.\&quot;payment_method\&quot;,'')) IN ('CARD','UPI','BANK_TRANSFER','CASH') AND UPPER(COALESCE(P.\&quot;payment_status\&quot;,'')) IN ('SUCCESS','FAILED','PENDING','REFUNDED') &quot; +&#xD;&#xA;&#x9;        &quot;QUALIFY ROW_NUMBER() OVER(PARTITION BY P.\&quot;payment_id\&quot; ORDER BY P.\&quot;updated_at\&quot; DESC NULLS LAST)=1) S ON T.PAYMENT_ID=S.PAYMENT_ID &quot; +&#xD;&#xA;&#x9;        &quot;WHEN MATCHED THEN UPDATE SET T.ORDER_ID=S.ORDER_ID,T.PAYMENT_DATE=S.PAYMENT_DATE,T.PAYMENT_AMOUNT=S.PAYMENT_AMOUNT,T.PAYMENT_METHOD=S.PAYMENT_METHOD,T.PAYMENT_STATUS=S.PAYMENT_STATUS,T.UPDATED_AT=S.UPDATED_AT,T.DQ_STATUS=S.DQ_STATUS,T.DQ_RUN_ID='&quot; + runId + &quot;',T.PROCESSED_AT=CURRENT_TIMESTAMP() &quot; +&#xD;&#xA;&#x9;        &quot;WHEN NOT MATCHED THEN INSERT (PAYMENT_ID,ORDER_ID,PAYMENT_DATE,PAYMENT_AMOUNT,PAYMENT_METHOD,PAYMENT_STATUS,UPDATED_AT,DQ_STATUS,DQ_RUN_ID,PROCESSED_AT) VALUES (S.PAYMENT_ID,S.ORDER_ID,S.PAYMENT_DATE,S.PAYMENT_AMOUNT,S.PAYMENT_METHOD,S.PAYMENT_STATUS,S.UPDATED_AT,S.DQ_STATUS,'&quot; + runId + &quot;',CURRENT_TIMESTAMP())&quot;&#xD;&#xA;&#x9;    );&#xD;&#xA; &#xD;&#xA;&#x9;    st.executeUpdate(&#xD;&#xA;&#x9;        &quot;INSERT INTO &quot; + exception + &quot;.DQ_EXCEPTION SELECT '&quot; + runId + &quot;','ORDER_PAYMENT_BALANCE',TO_VARCHAR(O.\&quot;order_id\&quot;),'PAYMENT_OVER_ORDER_AMOUNT','Successful payment total exceeds order amount','MAJOR','PAYMENT_AMOUNT',TO_VARCHAR(SUM(P.\&quot;payment_amount\&quot;)-MAX(O.\&quot;order_amount\&quot;)),CURRENT_TIMESTAMP(),'OPEN' &quot; +&#xD;&#xA;&#x9;        &quot;FROM &quot; + rawOrders + &quot; O JOIN &quot; + rawPayments + &quot; P ON P.\&quot;order_id\&quot;=O.\&quot;order_id\&quot; AND UPPER(P.\&quot;payment_status\&quot;)='SUCCESS' GROUP BY O.\&quot;order_id\&quot; HAVING SUM(P.\&quot;payment_amount\&quot;)>MAX(O.\&quot;order_amount\&quot;)&quot;&#xD;&#xA;&#x9;    );&#xD;&#xA; &#xD;&#xA;&#x9;    // CURATED represents the current accepted state. Remove rows deleted from RAW or&#xD;&#xA;&#x9;    // rows that became invalid in this run, processing children before parents.&#xD;&#xA;&#x9;    st.executeUpdate(&quot;DELETE FROM &quot; + curated + &quot;.PAYMENTS WHERE DQ_RUN_ID IS NULL OR DQ_RUN_ID&lt;>'&quot; + runId + &quot;'&quot;);&#xD;&#xA;&#x9;    st.executeUpdate(&quot;DELETE FROM &quot; + curated + &quot;.ORDERS WHERE DQ_RUN_ID IS NULL OR DQ_RUN_ID&lt;>'&quot; + runId + &quot;'&quot;);&#xD;&#xA;&#x9;    st.executeUpdate(&quot;DELETE FROM &quot; + curated + &quot;.CUSTOMER WHERE DQ_RUN_ID IS NULL OR DQ_RUN_ID&lt;>'&quot; + runId + &quot;'&quot;);&#xD;&#xA; &#xD;&#xA;&#x9;    // FIX: Snowflake's UPDATE ... SET clause does not accept the target table alias&#xD;&#xA;&#x9;    // qualifying the assignment target itself (e.g. &quot;SET R.STATUS=...&quot; is invalid —&#xD;&#xA;&#x9;    // only the bare column name is allowed on the left of &quot;=&quot; in a SET list). The&#xD;&#xA;&#x9;    // alias R is only valid in the WHERE clause and inside correlated subqueries.&#xD;&#xA;&#x9;    // This was the actual source of &quot;invalid identifier 'STATUS'&quot;. Removed the R.&#xD;&#xA;&#x9;    // prefix from every SET target column below; WHERE R.RUN_ID=... is unchanged.&#xD;&#xA;&#x9;    st.executeUpdate(&#xD;&#xA;&#x9;        &quot;UPDATE &quot; + control + &quot;.DQ_RUN R SET &quot; +&#xD;&#xA;&#x9;        &quot;END_TS=CURRENT_TIMESTAMP(),&quot; +&#xD;&#xA;&#x9;        &quot;ROWS_READ=(SELECT COUNT(*) FROM &quot; + rawCustomer + &quot;)+(SELECT COUNT(*) FROM &quot; + rawOrders + &quot;)+(SELECT COUNT(*) FROM &quot; + rawPayments + &quot;),&quot; +&#xD;&#xA;&#x9;        &quot;ROWS_PASSED=(SELECT COUNT(*) FROM &quot; + curated + &quot;.CUSTOMER WHERE DQ_RUN_ID='&quot; + runId + &quot;')+(SELECT COUNT(*) FROM &quot; + curated + &quot;.ORDERS WHERE DQ_RUN_ID='&quot; + runId + &quot;')+(SELECT COUNT(*) FROM &quot; + curated + &quot;.PAYMENTS WHERE DQ_RUN_ID='&quot; + runId + &quot;'),&quot; +&#xD;&#xA;&#x9;        &quot;ROWS_REJECTED=(SELECT COUNT(DISTINCT ENTITY_NAME||'|'||RECORD_KEY) FROM &quot; + exception + &quot;.DQ_EXCEPTION WHERE RUN_ID='&quot; + runId + &quot;' AND ENTITY_NAME IN ('CUSTOMER','ORDERS','PAYMENTS') AND SEVERITY IN ('CRITICAL','MAJOR')),&quot; +&#xD;&#xA;&#x9;        &quot;STATUS=CASE WHEN (SELECT COUNT(*) FROM &quot; + exception + &quot;.DQ_EXCEPTION WHERE RUN_ID='&quot; + runId + &quot;' AND SEVERITY IN ('CRITICAL','MAJOR'))>0 THEN 'COMPLETED_WITH_EXCEPTIONS' WHEN (SELECT COUNT(*) FROM &quot; + exception + &quot;.DQ_EXCEPTION WHERE RUN_ID='&quot; + runId + &quot;')>0 THEN 'COMPLETED_WITH_WARNINGS' ELSE 'COMPLETED' END &quot; +&#xD;&#xA;&#x9;        &quot;WHERE R.RUN_ID='&quot; + runId + &quot;'&quot;&#xD;&#xA;&#x9;    );&#xD;&#xA;&#x9;    sf.commit();&#xD;&#xA;&#x9;    System.out.println(&quot;DQ run completed: &quot; + context.run_id);&#xD;&#xA;&#x9;} catch (Exception e) {&#xD;&#xA;&#x9;    try { sf.rollback(); } catch (Exception ignored) {}&#xD;&#xA;&#x9;    try {&#xD;&#xA;&#x9;        sf.setAutoCommit(true);&#xD;&#xA;&#x9;        try (java.sql.PreparedStatement ps = sf.prepareStatement(&quot;INSERT INTO &quot; + control + &quot;.DQ_RUN (RUN_ID,JOB_NAME,ENVIRONMENT,START_TS,END_TS,STATUS,ERROR_MESSAGE) VALUES (?,?,?,CURRENT_TIMESTAMP(),CURRENT_TIMESTAMP(),'FAILED',?)&quot;)) {&#xD;&#xA;&#x9;            ps.setString(1, context.run_id);&#xD;&#xA;&#x9;            ps.setString(2, &quot;MJ_QTC_STORAGE_TO_CURATED_DQ&quot;);&#xD;&#xA;&#x9;            ps.setString(3, context.environment);&#xD;&#xA;&#x9;            ps.setString(4, e.getMessage());&#xD;&#xA;&#x9;            ps.executeUpdate();&#xD;&#xA;&#x9;        }&#xD;&#xA;&#x9;    } catch (Exception auditError) {&#xD;&#xA;&#x9;        System.err.println(&quot;Unable to record DQ failure: &quot; + auditError.getMessage());&#xD;&#xA;&#x9;    }&#xD;&#xA;&#x9;    throw new RuntimeException(&quot;DQ Job failed for run &quot; + context.run_id, e);&#xD;&#xA;&#x9;} finally {&#xD;&#xA;&#x9;    if (ownsConnection &amp;&amp; sf != null) {&#xD;&#xA;&#x9;        try {&#xD;&#xA;&#x9;            sf.close();&#xD;&#xA;&#x9;            globalMap.put(&quot;conn_tDBConnection_1&quot;, null);&#xD;&#xA;&#x9;        } catch (Exception closeEx) {&#xD;&#xA;&#x9;            System.err.println(&quot;Failed to close fallback Snowflake connection: &quot; + closeEx.getMessage());&#xD;&#xA;&#x9;        }&#xD;&#xA;&#x9;    }&#xD;&#xA;&#x9;}&#xD;&#xA; "/>
