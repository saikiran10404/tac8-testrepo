    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="if (context.run_id == null || context.run_id.trim().isEmpty()) {&#xA;    context.run_id = &quot;DQ_&quot; + java.time.format.DateTimeFormatter.ofPattern(&quot;yyyyMMdd_HHmmss_SSS&quot;)&#xA;        .withZone(java.time.ZoneOffset.UTC).format(java.time.Instant.now())&#xA;        + &quot;_&quot; + java.util.UUID.randomUUID().toString().substring(0, 8);&#xA;}&#xA;globalMap.put(&quot;DQ_RUN_ID&quot;, context.run_id);&#xA;System.out.println(&quot;Starting DQ run &quot; + context.run_id + &quot; in &quot; + context.environment);&#xA;"/>
