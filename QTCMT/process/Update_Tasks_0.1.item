    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE_MAIN" value="taskMap.computeIfAbsent(row3.task_id, k -> {&#xD;&#xA;    java.util.Map&lt;String,Object> m = new java.util.LinkedHashMap&lt;>();&#xD;&#xA;    m.put(&quot;taskId&quot;, row3.task_id);&#xD;&#xA;    m.put(&quot;taskName&quot;, row3.task_name);&#xD;&#xA;    m.put(&quot;contextName&quot;, row3.context_group != null ? row3.context_group : &quot;Default&quot;);&#xD;&#xA;    m.put(&quot;context&quot;, new java.util.LinkedHashMap&lt;String,String>());&#xD;&#xA;    return m;&#xD;&#xA;});&#xD;&#xA;if (row3.param_name != null) {&#xD;&#xA;    ((java.util.Map&lt;String,String>) taskMap.get(row3.task_id).get(&quot;context&quot;))&#xD;&#xA;        .put(row3.param_name, row3.param_value);&#xD;&#xA;}"/>
